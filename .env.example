HOST=127.0.0.1
PORT=3000
SWAGGER_ENABLED=false

# Define contraseñas locales diferentes al usar Docker Compose.
POSTGRES_DEV_PASSWORD=
POSTGRES_DEV_PORT=55432
POSTGRES_TEST_PASSWORD=
POSTGRES_TEST_PORT=55433

# Prisma CLI. Configura la URL del entorno que corresponda.
DATABASE_URL=

# Opcional para npm test con la base aislada sig_test.
DATABASE_TEST_URL=

# Solo para los comandos SIG explícitos --plan y --apply.
SIG_IMPORT_DATABASE_URL=

# Solo para npm run start:ibite-demo. Clave local de 32 bytes en hexadecimal.
IBITE_DEMO_CAPTURE_KEY=

# Solo para planificar el piloto IBITE por consulta de solo lectura.
IBITE_PLAN_DATABASE_URL=
